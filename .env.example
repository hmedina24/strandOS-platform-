# Copy this file to .env for local development. Never commit a real .env file.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/strandos

# Authentication
AUTH_SECRET=replace-with-a-local-development-secret

# Integrations (use test credentials locally)
PAYMENT_PROVIDER_SECRET_KEY=
MESSAGING_PROVIDER_API_KEY=
STORAGE_BUCKET=
